{
  "name": "mario-electron",
  "version": "2.0.0",
  "description": "Mario — your notes, your world (Electron + macOS 27 UI)",
  "main": "dist-electron/main.cjs",
  "private": true,
  "scripts": {
    "dev:renderer": "vite --port 5173",
    "build:main": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && node scripts/launch-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
