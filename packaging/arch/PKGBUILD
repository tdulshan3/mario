# Maintainer: Thushara Dulshan <135942637+tdulshan3@users.noreply.github.com>
pkgname=mario
pkgver=2.0.0
pkgrel=3
pkgdesc="Mario — an Electron + React macOS 27 desktop notes & AI agent app with local-first Drive sync"
arch=('x86_64')
url="https://github.com/tdulshan3/mario"
license=('custom')
depends=(
  'electron44'
  'xdg-utils'
  'libsecret'
)
options=('!strip' '!debug')
install="${pkgname}.install"

source=(
  "mario-${pkgver}-x86_64.tar.gz"
  "mario.desktop"
  "mario.sh"
  "mario.png"
)
sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
)

package() {
  # Electron app bundle lives at /opt/mario
  install -d "${pkgdir}/opt/${pkgname}"
  cp -a "${srcdir}/bundle/." "${pkgdir}/opt/${pkgname}/"

  # Launcher in $PATH.
  install -Dm0755 "${srcdir}/mario.sh" "${pkgdir}/usr/bin/${pkgname}"

  # Desktop entry.
  install -Dm0644 "${srcdir}/mario.desktop" \
    "${pkgdir}/usr/share/applications/${pkgname}.desktop"

  # Hicolor icon
  if [ -f "${srcdir}/bundle/public/assets/logo/mario_mark.png" ]; then
    install -Dm0644 \
      "${srcdir}/bundle/public/assets/logo/mario_mark.png" \
      "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"
  elif [ -f "${srcdir}/mario.png" ]; then
    install -Dm0644 "${srcdir}/mario.png" \
      "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"
  fi

  install -Dm0644 /dev/null "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
